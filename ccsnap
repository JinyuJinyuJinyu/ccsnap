#!/usr/bin/env python3
"""ccsnap - snapshot tmux sessions running Claude Code, and restore them after a reboot.

  ccsnap save              take a snapshot now (autosave does this every 2 minutes)
  ccsnap list              list snapshots, newest first
  ccsnap show [N]          show what a snapshot would restore
  ccsnap restore [N]       recreate missing tmux sessions and resume their Claude sessions
  ccsnap auto on|off       turn autosave on or off (systemd timer on Linux, launchd on macOS)

Snapshots are small JSON files in ~/.local/state/ccsnap/snapshots (Linux) or
~/.ccsnap/snapshots (macOS); $CCSNAP_HOME overrides. Standard library only.
"""

import argparse
import calendar
import json
import os
import plistlib
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

__version__ = "0.2.0"

MAC = sys.platform == "darwin"
# Linux reads /proc. Elsewhere (macOS) the same facts come from `ps`; CCSNAP_PS=1 forces
# that path on Linux too, which is how it gets exercised without a Mac.
USE_PROC = os.path.isdir("/proc/self") and not os.environ.get("CCSNAP_PS")

HOME = Path.home()
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
if os.environ.get("CCSNAP_HOME"):
    STATE_DIR = Path(os.environ["CCSNAP_HOME"])
elif MAC:
    STATE_DIR = HOME / ".ccsnap"
else:
    STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "ccsnap"
SNAP_DIR = STATE_DIR / "snapshots"
UNIT_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "systemd/user"
LAUNCHD_LABEL = "com.ccsnap.autosave"
LAUNCHD_PLIST = HOME / "Library/LaunchAgents" / (LAUNCHD_LABEL + ".plist")
AUTO_LOG = STATE_DIR / "auto.log"
KEEP = 200            # snapshots kept on disk (identical states are never re-saved)
# `tmux -L <name>`: point ccsnap at a scratch tmux server. None = the default server.
TMUX_SOCKET = os.environ.get("CCSNAP_TMUX_SOCKET") or None


# ---------------------------------------------------------------- tmux helpers

_TMUX_BIN = None


def tmux_bin():
    """tmux from PATH, else the usual install places (launchd and systemd run with a bare PATH)."""
    global _TMUX_BIN
    if _TMUX_BIN is None:
        _TMUX_BIN = shutil.which("tmux") or next(
            (p for p in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux")
             if os.path.exists(p)), "tmux")
    return _TMUX_BIN


def tmux(*args, check=True):
    # -u: UTF-8 output even under the C locale that autosave runs in, so session and window
    # names with non-ASCII characters are recorded as they are.
    cmd = [tmux_bin(), "-u"] + (["-L", TMUX_SOCKET] if TMUX_SOCKET else []) + [str(a) for a in args]
    try:
        r = subprocess.run(cmd, capture_output=True, encoding="utf-8", errors="replace")
    except OSError as e:
        r = subprocess.CompletedProcess(cmd, 127, "", f"cannot run tmux: {e}")
    if check and r.returncode != 0:
        raise RuntimeError(f"`{shlex.join(cmd)}` failed: {r.stderr.strip()}")
    return r


def tmux_rows(args, fields):
    """Run a tmux list command; return list of dicts, or None if no server is running."""
    fmt = "\t".join("#{%s}" % f for f in fields)
    r = tmux(*args, "-F", fmt, check=False)
    if r.returncode != 0:
        return None
    return [dict(zip(fields, line.split("\t"))) for line in r.stdout.splitlines()]


def current_session_names():
    rows = tmux_rows(["list-sessions"], ["session_name"])
    return {r["session_name"] for r in rows or []}


# ---------------------------------------------------------------- processes + claude state

_PS = {"at": 0.0, "table": {}}


def parse_lstart(text):
    """`ps -o lstart`, and the procStart Claude records on macOS ("Mon Nov 16 03:55:33 2026",
    UTC), as epoch seconds. None if it is not in that form."""
    try:
        return calendar.timegm(time.strptime(" ".join(str(text).split()), "%a %b %d %H:%M:%S %Y"))
    except (ValueError, TypeError):
        return None


def ps_table():
    """pid -> (ppid, start epoch, command line) from `ps`, for systems without /proc.
    ps runs in UTC so start times compare directly with Claude's procStart. The table is
    reused for a second: one ccsnap command asks about many pids."""
    if time.time() - _PS["at"] > 1.0:
        try:
            out = subprocess.run(
                ["ps", "-A", "-ww", "-o", "pid=", "-o", "ppid=", "-o", "lstart=", "-o", "command="],
                capture_output=True, encoding="utf-8", errors="replace",
                env=dict(os.environ, LC_ALL="C", TZ="UTC")).stdout
        except OSError:
            out = ""
        table = {}
        for line in out.splitlines():
            parts = line.split(None, 7)   # pid, ppid, five lstart words, the rest
            if len(parts) < 7:
                continue
            try:
                pid, ppid = int(parts[0]), int(parts[1])
            except ValueError:
                continue
            table[pid] = (ppid, parse_lstart(" ".join(parts[2:7])), parts[7] if len(parts) > 7 else "")
        _PS["at"], _PS["table"] = time.time(), table
    return _PS["table"]


def proc_stat(pid):
    """(ppid, start) of a live process, or None. `start` tells a process from a later one
    that reused its pid: the /proc starttime on Linux, epoch seconds from ps elsewhere."""
    if not USE_PROC:
        row = ps_table().get(int(pid))
        return (row[0], row[1]) if row else None
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
    except OSError:
        return None
    rest = s[s.rfind(")") + 2:].split()
    return int(rest[1]), rest[19]


def proc_argv(pid):
    """The process's command line as a list, or None. From ps it is split on spaces, so an
    argument containing spaces comes back in pieces; /proc keeps arguments intact."""
    if not USE_PROC:
        row = ps_table().get(int(pid))
        return row[2].split() if row else None
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return None
    return [a.decode(errors="replace") for a in raw.rstrip(b"\0").split(b"\0")]


def children_map():
    pids = list(ps_table()) if not USE_PROC else [int(d) for d in os.listdir("/proc") if d.isdigit()]
    kids = {}
    for pid in pids:
        st = proc_stat(pid)
        if st:
            kids.setdefault(st[0], []).append(pid)
    return kids


def same_process(recorded, start):
    """Is the process holding a pid now the one Claude recorded a start time for?"""
    if not recorded:
        return True
    if USE_PROC:
        return str(recorded) == start
    rec = parse_lstart(recorded)
    return rec is None or start is None or abs(rec - start) <= 5


def live_claude_sessions():
    """pid -> ~/.claude/sessions/<pid>.json record, for processes that are still alive."""
    out = {}
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
            pid = int(d["pid"])
            d["sessionId"]
        except Exception:
            continue
        st = proc_stat(pid)
        if not st:
            continue
        if not same_process(d.get("procStart"), st[1]):
            continue  # stale file, pid was reused
        out[pid] = d
    return out


def find_claude(pane_pid, kids, live):
    """Breadth-first search below the pane's shell for a Claude Code process."""
    queue = [pane_pid]
    while queue:
        pid = queue.pop(0)
        if pid in live and live[pid].get("kind", "interactive") == "interactive":
            return pid
        queue.extend(kids.get(pid, []))
    return None


def claude_argv(pid, strict=False):
    """Arguments after the `claude` executable. strict=True: None if it isn't a claude process."""
    argv = proc_argv(pid)
    if not argv:
        return None if strict else []
    for i, a in enumerate(argv):
        base = os.path.basename(a)
        # The native install runs as .../claude/versions/<version>, so argv[0] may not be
        # named "claude" at all.
        if (base == "claude" or base.endswith(("cli.js", "cli.mjs"))
                or (i == 0 and "/claude/versions/" in a)):
            return argv[i + 1:]
    return None if strict else argv[1:]


def find_attach(pane_pid, kids):
    """A pane running `claude attach <id|name>` has no session file; find it by cmdline."""
    queue = [pane_pid]
    while queue:
        pid = queue.pop(0)
        args = claude_argv(pid, strict=True)
        if args and args[0] == "attach" and len(args) > 1:
            return args[1]
        queue.extend(kids.get(pid, []))
    return None


def resolve_job(ref):
    """Map an attach argument (job id, or part of a job's name) to (job_id, state)."""
    jobs = CLAUDE_DIR / "jobs"
    if (jobs / ref).is_dir():
        return ref, job_state(ref) or {}
    for d in sorted(jobs.glob("*/state.json")):
        try:
            st = json.loads(d.read_text())
        except Exception:
            continue
        if ref.lower() in (st.get("name") or "").lower():
            return d.parent.name, st
    return ref, {}


# Flags we must not replay on restore (they pick/create a session, or a one-shot mode).
DROP = {"-r", "--resume", "-c", "--continue", "--session-id", "--fork-session", "-n", "--name",
        "-p", "--print", "--bg", "--background", "--from-pr", "--teleport", "--cloud",
        "-w", "--worktree", "--tmux"}
VALUE = {"--model", "--permission-mode", "--effort", "--agent", "--settings", "--setting-sources",
         "--append-system-prompt", "--system-prompt", "--system-prompt-file",
         "--append-system-prompt-file", "--fallback-model", "--output-format", "--input-format",
         "--max-turns", "--max-budget-usd", "--session-id", "-n", "--name", "--tools",
         "--json-schema", "--agents", "--permission-prompt-tool", "--plugin-url", "--environment"}
VARIADIC = {"--add-dir", "--mcp-config", "--allowedTools", "--allowed-tools", "--disallowedTools",
            "--disallowed-tools", "--plugin-dir", "--betas"}
OPTIONAL = {"-r", "--resume", "-d", "--debug", "--remote-control", "-w", "--worktree",
            "--from-pr", "--teleport", "--cloud"}


def sanitize_args(args):
    """Keep the user's flags (e.g. --dangerously-skip-permissions, --model X), drop session
    selectors and any positional prompt (which would otherwise be re-sent on resume)."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            break
        if not a.startswith("-"):
            i += 1
            continue
        name = a.split("=", 1)[0]
        vals = []
        if not (a.startswith("--") and "=" in a):
            if name in VARIADIC:
                j = i + 1
                while j < len(args) and not args[j].startswith("-"):
                    vals.append(args[j])
                    j += 1
            elif name in VALUE and i + 1 < len(args):
                vals.append(args[i + 1])
            elif name in OPTIONAL and i + 1 < len(args) and not args[i + 1].startswith("-"):
                vals.append(args[i + 1])
        i += 1 + len(vals)
        if name not in DROP:
            out += [a] + vals
    return out


def transcript_exists(session_id):
    return any((CLAUDE_DIR / "projects").glob(f"*/{session_id}.jsonl"))


def job_state(job_id):
    try:
        return json.loads((CLAUDE_DIR / "jobs" / job_id / "state.json").read_text())
    except Exception:
        return None


# ---------------------------------------------------------------- capture

def capture():
    wins = tmux_rows(["list-windows", "-a"],
                     ["session_name", "window_index", "window_name", "window_layout",
                      "window_active", "window_width", "window_height", "automatic-rename"])
    panes = tmux_rows(["list-panes", "-a"],
                      ["session_name", "window_index", "pane_index", "pane_pid",
                       "pane_current_path", "pane_current_command", "pane_active"])
    sess_rows = tmux_rows(["list-sessions"], ["session_name", "session_last_attached"])
    if wins is None or panes is None or sess_rows is None:
        return None

    kids, live = children_map(), live_claude_sessions()
    sessions = {}
    for s in sess_rows:
        sessions[s["session_name"]] = {"name": s["session_name"], "windows": {}}
    for w in wins:
        sessions[w["session_name"]]["windows"][w["window_index"]] = {
            "index": int(w["window_index"]), "name": w["window_name"],
            "layout": w["window_layout"], "active": w["window_active"] == "1",
            "width": int(w["window_width"]), "height": int(w["window_height"]),
            "auto_rename": w["automatic-rename"] == "1", "panes": []}
    for p in panes:
        pane = {"index": int(p["pane_index"]), "cwd": p["pane_current_path"] or str(HOME),
                "active": p["pane_active"] == "1", "command": p["pane_current_command"]}
        pid = find_claude(int(p["pane_pid"]), kids, live)
        if pid:
            rec = live[pid]
            sid = rec["sessionId"]
            c = {"session_id": sid, "name": rec.get("name"), "name_source": rec.get("nameSource"),
                 "cwd": rec.get("cwd") or pane["cwd"],
                 "args": sanitize_args(claude_argv(pid)), "had_transcript": transcript_exists(sid)}
            if rec.get("parkedJobId"):
                job = job_state(rec["parkedJobId"]) or {}
                c["job_id"] = rec["parkedJobId"]
                c["job_session_id"] = job.get("resumeSessionId") or job.get("sessionId")
                c["job_name"] = job.get("name")
            pane["claude"] = c
        elif (ref := find_attach(int(p["pane_pid"]), kids)):
            job_id, job = resolve_job(ref)
            pane["claude"] = {"job_id": job_id, "job_name": job.get("name"),
                              "job_session_id": job.get("resumeSessionId") or job.get("sessionId"),
                              "session_id": None, "name": job.get("name"),
                              "cwd": job.get("cwd") or pane["cwd"], "args": [], "attach": True}
        sessions[p["session_name"]]["windows"][p["window_index"]]["panes"].append(pane)

    out = []
    for s in sessions.values():
        wl = sorted(s["windows"].values(), key=lambda w: w["index"])
        for w in wl:
            w["panes"].sort(key=lambda p: p["index"])
        out.append({"name": s["name"], "windows": wl})
    return out


def snap_counts(sessions):
    panes = [p for s in sessions for w in s["windows"] for p in w["panes"]]
    return len(panes), sum(1 for p in panes if "claude" in p)


# ---------------------------------------------------------------- snapshot store

_LOADED = {}


def load(path):
    """A snapshot as a dict, or None if the file is unreadable or is not one of ours (the
    first, macOS-only ccsnap wrote a different format into the same folder)."""
    key = str(path)
    if key not in _LOADED:
        try:
            d = json.loads(Path(path).read_text())
        except (OSError, ValueError):
            d = None
        ok = isinstance(d, dict) and isinstance(d.get("sessions"), list) and "saved_at" in d
        _LOADED[key] = d if ok else None
    return _LOADED[key]


def snapshots():
    """Paths of the usable snapshots, newest first."""
    good = [p for p in SNAP_DIR.glob("*.json") if load(p)]
    return sorted(good, key=lambda p: (load(p)["saved_at"], p.name), reverse=True)


def boot_time():
    if MAC:
        try:
            out = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True, text=True).stdout
            return int(out.split("sec =")[1].split(",")[0])
        except (OSError, IndexError, ValueError):
            return 0
    try:
        with open("/proc/stat") as f:
            for line in f:
                if line.startswith("btime"):
                    return int(line.split()[1])
    except OSError:
        pass
    return 0


MARKER = STATE_DIR / "restored-boot"


def boot_id():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return str(boot_time())  # no such file on macOS; the boot time identifies the boot


def restored_this_boot():
    try:
        return MARKER.read_text().strip() == boot_id()
    except OSError:
        return False


def snap_time(p):
    try:
        return load(p)["saved_at"]
    except Exception:
        return 0


def default_snapshot(snaps, current):
    """Until a restore has succeeded in this boot, only snapshots from *before* the reboot
    count: the timer keeps saving while the machine comes up, and those post-boot snapshots
    are the empty/broken state, not the one you want back. Among the candidates, take the
    newest one with a tmux session that isn't running now (else the newest candidate)."""
    cands = snaps
    if not restored_this_boot():
        bt = boot_time()
        cands = [p for p in snaps if snap_time(p) < bt] or snaps
    for p in cands:
        try:
            if any(s["name"] not in current for s in load(p)["sessions"]):
                return p
        except Exception:
            continue
    return cands[0] if cands else None


def needed_dirs(sess):
    return {p["claude"]["cwd"] if "claude" in p else p["cwd"]
            for w in sess["windows"] for p in w["panes"]}


def resolve_snapshot(ref, snaps, current):
    if ref is None:
        return default_snapshot(snaps, current)
    if ref.isdigit() and 1 <= int(ref) <= len(snaps):
        return snaps[int(ref) - 1]
    p = Path(ref)
    if p.is_file():
        if not load(p):
            sys.exit(f"ccsnap: {ref} is not a ccsnap snapshot")
        return p
    hits = [s for s in snaps if s.stem.startswith(ref)]   # e.g. 20261116-09
    if len(hits) == 1:
        return hits[0]
    if hits:
        sys.exit(f"ccsnap: '{ref}' matches {len(hits)} snapshots, be more specific")
    sys.exit(f"ccsnap: no snapshot '{ref}' (see `ccsnap list`)")


# ---------------------------------------------------------------- commands

def cmd_save(a):
    a.quiet = a.quiet or a.auto
    sessions = capture()
    if sessions is None:
        if not a.quiet:
            print("ccsnap: no tmux server running — nothing saved")
        return
    snaps = snapshots()
    if snaps and not a.force:
        try:
            if load(snaps[0])["sessions"] == sessions:
                if not a.quiet:
                    print(f"unchanged since {snaps[0].name} — not saved again")
                return
        except Exception:
            pass
    SNAP_DIR.mkdir(parents=True, exist_ok=True)
    now = time.time()
    stem = datetime.fromtimestamp(now).strftime("%Y%m%d-%H%M%S")
    path, n = SNAP_DIR / (stem + ".json"), 2
    while path.exists():  # never overwrite: a second save in the same second, or a foreign file
        path, n = SNAP_DIR / f"{stem}-{n}.json", n + 1
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"version": 1, "saved_at": now, "sessions": sessions}, indent=1))
    tmp.replace(path)
    for old in snapshots()[KEEP:]:
        try:
            old.unlink()
        except OSError:
            pass
    if not a.quiet:
        n_panes, n_claude = snap_counts(sessions)
        print(f"saved {path}\n  {len(sessions)} tmux sessions, {n_panes} panes, "
              f"{n_claude} Claude sessions")


def cmd_list(a):
    snaps = snapshots()
    if not snaps:
        print("no snapshots yet — run `ccsnap save`, or `ccsnap auto on` to take them automatically")
        return
    current, bt = current_session_names(), boot_time()
    dflt = default_snapshot(snaps, current)
    print("    #  saved                claude  tmux sessions (panes)")
    shown_boot = False
    for i, p in enumerate(snaps[:a.n], 1):
        d = load(p)
        if not shown_boot and d["saved_at"] < bt and i > 1:
            print("    ---- last boot " + datetime.fromtimestamp(bt).strftime("%Y-%m-%d %H:%M") + " ----")
        shown_boot = shown_boot or d["saved_at"] < bt
        _, n_claude = snap_counts(d["sessions"])
        sess = " ".join(f"{s['name']}({sum(len(w['panes']) for w in s['windows'])})"
                        for s in d["sessions"])
        mark = "*" if p == dflt else " "
        when = datetime.fromtimestamp(d["saved_at"]).strftime("%Y-%m-%d %H:%M:%S")
        print(f"  {mark}{i:>3}  {when}  {n_claude:>6}  {sess}")
    why = ("newest with a tmux session that isn't running now" if restored_this_boot()
           else "last one from before the reboot — nothing restored yet this boot")
    print(f"\n  * = what `ccsnap restore` picks by default ({why})")
    if all(s["name"] in current for s in load(dflt)["sessions"]):
        print("  all its tmux sessions exist right now — `ccsnap restore --replace` rebuilds them")


def launch_cmd(pane, claude_bin):
    """Return (command, note) to type into a restored pane, or (None, None)."""
    c = pane.get("claude")
    if not c:
        return None, None
    if c.get("job_id"):
        if (CLAUDE_DIR / "jobs" / c["job_id"]).is_dir():
            return f"{claude_bin} attach {shlex.quote(c['job_id'])}", f"background job {c.get('job_name') or ''}".strip()
        sid = c.get("job_session_id") or c["session_id"]
        if not sid:  # unresolvable job reference: let `claude attach` try it as given
            return f"{claude_bin} attach {shlex.quote(c['job_id'])}", "background job (unresolved)"
    else:
        sid = c["session_id"]
    parts = [claude_bin]
    note = c.get("name") or ""
    if transcript_exists(sid):
        parts += ["--resume", sid]
    else:
        note = (note + " (no transcript yet → fresh session)").strip()
        if c.get("name") and c.get("name_source") == "user":
            parts += ["-n", shlex.quote(c["name"])]  # resumed sessions get their name from the transcript
    parts += [shlex.quote(x) for x in c.get("args", [])]
    return " ".join(parts), note


def print_plan(snap, claude_bin, only=None, current=()):
    for s in snap["sessions"]:
        if only and s["name"] not in only:
            continue
        tag = "   (exists now → skipped)" if s["name"] in current else ""
        print(f"tmux session {s['name']}{tag}")
        for w in s["windows"]:
            print(f"  window {w['index']}: {w['name']}  ({len(w['panes'])} panes)")
            for p in w["panes"]:
                cmd, note = launch_cmd(p, claude_bin)
                cwd = p["claude"]["cwd"] if "claude" in p else p["cwd"]
                what = f"{cmd}   # {note}" if cmd else f"shell (was: {p['command']})"
                print(f"    .{p['index']}  {cwd}\n         {what}")


def cmd_show(a):
    snaps = snapshots()
    if not snaps:
        sys.exit("ccsnap: no snapshots yet")
    current = current_session_names()
    path = resolve_snapshot(a.snapshot, snaps, current)
    snap = load(path)
    print(f"{path}  (saved {datetime.fromtimestamp(snap['saved_at']):%Y-%m-%d %H:%M:%S})\n")
    print_plan(snap, a.claude_bin, current=current)


def cmd_restore(a):
    snaps = snapshots()
    if not snaps:
        sys.exit("ccsnap: no snapshots yet — nothing to restore")
    current = current_session_names()
    path = resolve_snapshot(a.snapshot, snaps, current)
    snap = load(path)
    print(f"snapshot {path.name}  (saved {datetime.fromtimestamp(snap['saved_at']):%Y-%m-%d %H:%M:%S})")

    todo = [s for s in snap["sessions"] if (not a.only or s["name"] in a.only)]
    if a.only:
        for m in sorted(set(a.only) - {s["name"] for s in snap["sessions"]}):
            print(f"  skip {m}: not in this snapshot")
    replace = []
    if a.replace:
        here = None
        if os.environ.get("TMUX_PANE") and not TMUX_SOCKET:
            here = tmux("display", "-p", "-t", os.environ["TMUX_PANE"], "#{session_name}",
                        check=False).stdout.strip()
        replace = [s for s in todo if s["name"] in current and s["name"] != here]
        if here and here in current and any(s["name"] == here for s in todo):
            print(f"  skip {here}: ccsnap is running inside it, won't kill it")
    for s in todo:
        if s["name"] in current and s not in replace:
            print(f"  skip {s['name']}: a tmux session with that name already exists"
                  + ("" if a.replace else " (--replace to rebuild it)"))
    todo = [s for s in todo if s["name"] not in current or s in replace]
    if not todo:
        print("nothing to restore")
        return

    # Never launch Claude in the wrong folder: wait for missing folders (e.g. a data disk
    # still being fsck'd/mounted after boot), and skip sessions whose folders never appear.
    def missing_dirs():
        return {d for s in todo for d in needed_dirs(s) if not os.path.isdir(d)}
    gone = missing_dirs()
    if gone and not a.dry_run and a.wait > 0:
        print(f"waiting up to {a.wait}s for {len(gone)} folder(s) to appear (disk still mounting?):")
        for d in sorted(gone)[:6]:
            print(f"    {d}")
        deadline, next_note = time.time() + a.wait, time.time() + 30
        while gone and time.time() < deadline:
            time.sleep(2)
            gone = missing_dirs()
            if gone and time.time() >= next_note:
                print(f"  still waiting… ({int(deadline - time.time())}s left)")
                next_note += 30
        if not gone:
            print("  all folders present — continuing")
    failed = False
    if gone:
        for s in [s for s in todo if needed_dirs(s) & gone]:
            print(f"  skip {s['name']}: folder not found: {', '.join(sorted(needed_dirs(s) & gone))}")
            failed = True
        todo = [s for s in todo if not needed_dirs(s) & gone]
        replace = [s for s in replace if s in todo]
    if not todo:
        print("nothing restored — re-run `ccsnap restore` once the folders exist")
        sys.exit(1)
    if a.dry_run:
        print()
        if replace:
            print("would kill and rebuild: " + " ".join(s["name"] for s in replace) + "\n")
        print_plan({"sessions": todo}, a.claude_bin)
        return

    if replace:
        names = " ".join(s["name"] for s in replace)
        if not a.yes:
            if not sys.stdin.isatty():
                sys.exit(f"ccsnap: --replace would kill: {names} — add -y to confirm")
            if input(f"kill and rebuild these tmux sessions: {names} ? [y/N] ").strip().lower() != "y":
                sys.exit("aborted")
        kids, live = children_map(), live_claude_sessions()
        doomed = set()
        for s in replace:
            for r in tmux_rows(["list-panes", "-s", "-t", f"={s['name']}"], ["pane_pid"]) or []:
                q = [int(r["pane_pid"])]
                while q:
                    pid = q.pop()
                    doomed.add(pid)
                    q.extend(kids.get(pid, []))
            tmux("kill-session", "-t", f"={s['name']}", check=False)
            print(f"  killed {s['name']}")
        deadline = time.time() + 15  # let the old claude processes exit before resuming them
        while time.time() < deadline and any(proc_stat(p) for p in doomed & set(live)):
            time.sleep(0.5)

    live = live_claude_sessions()
    running = {d.get("sessionId") for d in live.values()}
    launches = []   # (pane_id, cmd, press_enter, label)
    for s in todo:
        active_win = None
        for wi, w in enumerate(s["windows"]):
            panes = w["panes"]
            cwds = [p["claude"]["cwd"] if "claude" in p else p["cwd"] for p in panes]
            fmt = "#{window_id}\t#{pane_id}"
            if wi == 0:
                out = tmux("new-session", "-d", "-P", "-F", fmt, "-s", s["name"], "-n", w["name"],
                           "-c", cwds[0], "-x", w["width"], "-y", w["height"]).stdout
                wid, first = out.strip().split("\t")
                idx = tmux("display", "-p", "-t", wid, "#{window_index}").stdout.strip()
                if idx != str(w["index"]):
                    tmux("move-window", "-s", wid, "-t", f"={s['name']}:{w['index']}")
            else:
                out = tmux("new-window", "-d", "-P", "-F", fmt, "-t", f"={s['name']}:{w['index']}",
                           "-n", w["name"], "-c", cwds[0]).stdout
                wid, first = out.strip().split("\t")
            tmux("resize-window", "-t", wid, "-x", w["width"], "-y", w["height"], check=False)
            pane_ids, last = [first], first
            for cwd in cwds[1:]:
                # split the *last* pane so pane index order == creation order == saved order
                last = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", last,
                            "-c", cwd).stdout.strip()
                pane_ids.append(last)
                tmux("select-layout", "-t", wid, "tiled", check=False)
            r = tmux("select-layout", "-t", wid, w["layout"], check=False)
            if r.returncode != 0:
                print(f"  warn {s['name']}:{w['index']}: couldn't reapply layout ({r.stderr.strip()}); tiled instead")
            tmux("set-option", "-w", "-u", "-t", wid, "window-size", check=False)
            if w.get("auto_rename"):
                tmux("set-option", "-w", "-t", wid, "automatic-rename", "on", check=False)
            for p, pid in zip(panes, pane_ids):
                if p.get("active"):
                    tmux("select-pane", "-t", pid, check=False)
                cmd, note = launch_cmd(p, a.claude_bin)
                if cmd:
                    sid = p["claude"].get("session_id")
                    clash = (not p["claude"].get("job_id")) and sid in running and not a.force
                    label = f"{s['name']}:{w['index']}.{p['index']}"
                    if clash:
                        note = f"{note} — ALREADY RUNNING elsewhere, typed but not started".strip(" —")
                    launches.append((pid, cmd, not (clash or a.no_enter), f"{label}  {note}".rstrip()))
            if w.get("active"):
                active_win = wid
        if active_win:
            tmux("select-window", "-t", active_win, check=False)
        print(f"  created {s['name']}: {len(s['windows'])} window(s), "
              f"{sum(len(w['panes']) for w in s['windows'])} pane(s)")

    if launches:
        time.sleep(a.settle)  # let the new shells finish starting before typing into them
        print(f"\n{'typing' if a.no_enter else 'starting'} {len(launches)} Claude session(s):")
        for pid, cmd, enter, label in launches:
            tmux("send-keys", "-t", pid, "-l", cmd)
            if enter:
                tmux("send-keys", "-t", pid, "Enter")
                time.sleep(a.stagger)
            print(f"  {'▶' if enter else '·'} {label}")

    try:  # from now on in this boot, `restore` may default to snapshots taken after the reboot
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        MARKER.write_text(boot_id())
    except OSError:
        pass
    if failed:
        print("\nsome sessions were skipped (see above) — re-run `ccsnap restore` when their folders exist")

    first = todo[0]["name"]
    if a.attach:
        if os.environ.get("TMUX") and not TMUX_SOCKET:
            tmux("switch-client", "-t", first, check=False)
        else:
            os.execvp(tmux_bin(), ["tmux"] + (["-L", TMUX_SOCKET] if TMUX_SOCKET else []) + ["attach", "-t", first])
    else:
        sock = f" -L {shlex.quote(TMUX_SOCKET)}" if TMUX_SOCKET else ""
        verb = "switch-client" if os.environ.get("TMUX") and not TMUX_SOCKET else "attach"
        print(f"\ndone. jump in with:  tmux{sock} {verb} -t {shlex.quote(first)}")
        if failed:
            sys.exit(1)


# ---------------------------------------------------------------- autosave

SERVICE = """[Unit]
Description=ccsnap: snapshot tmux + Claude Code sessions

[Service]
Type=oneshot
ExecStart="{python}" "{script}" save --quiet
LogLevelMax=notice
"""
TIMER = """[Unit]
Description=ccsnap: snapshot tmux + Claude Code sessions every {mins} min

[Timer]
OnStartupSec=1min
OnUnitActiveSec={mins}min
AccuracySec=10s

[Install]
WantedBy=timers.target
"""


def stable_python():
    """The interpreter autosave should run under. The system Python is preferred: it stays
    put when a conda or pyenv setup changes."""
    if os.path.exists("/usr/bin/python3"):
        try:
            if subprocess.run(["/usr/bin/python3", "-c", "pass"], capture_output=True).returncode == 0:
                return "/usr/bin/python3"
        except OSError:
            pass
    return sys.executable


def quiet(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def latest_line():
    snaps = snapshots()
    if snaps:
        print(f"latest snapshot: {datetime.fromtimestamp(load(snaps[0])['saved_at']):%Y-%m-%d %H:%M:%S}"
              f"  ({len(snaps)} kept in {SNAP_DIR})")


def have_systemd_user():
    return bool(shutil.which("systemctl")) and quiet(["systemctl", "--user", "show-environment"]).returncode == 0


def systemd_auto(action, every):
    if action == "status":
        on = quiet(["systemctl", "--user", "is-active", "ccsnap.timer"]).stdout.strip() == "active"
        mins = "?"
        try:
            for line in (UNIT_DIR / "ccsnap.timer").read_text().splitlines():
                if line.startswith("OnUnitActiveSec="):
                    mins = line.split("=", 1)[1].replace("min", "")
        except OSError:
            pass
        print(f"autosave: on, every {mins} min (systemd timer)" if on
              else "autosave: off  (turn on with `ccsnap auto on`)")
        latest_line()
        return
    if action == "off":
        subprocess.run(["systemctl", "--user", "disable", "--now", "ccsnap.timer"], check=False)
        for f in ("ccsnap.timer", "ccsnap.service"):
            try:
                (UNIT_DIR / f).unlink()
            except OSError:
                pass
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        print(f"autosave off (snapshots kept in {SNAP_DIR})")
        return
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    (UNIT_DIR / "ccsnap.service").write_text(
        SERVICE.format(python=stable_python(), script=Path(__file__).resolve()))
    (UNIT_DIR / "ccsnap.timer").write_text(TIMER.format(mins=every))
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "ccsnap.timer"], check=True)
    subprocess.run(["systemctl", "--user", "start", "ccsnap.service"], check=False)
    print(f"autosave on: every {every} min → {SNAP_DIR}")
    subprocess.run(["systemctl", "--user", "list-timers", "ccsnap.timer", "--no-pager"])


def launchd_auto(action, every):
    """macOS: a launchd agent that runs `ccsnap save --quiet` on an interval and at login."""
    domain = f"gui/{os.getuid()}"
    target = f"{domain}/{LAUNCHD_LABEL}"
    if action == "status":
        if quiet(["launchctl", "print", target]).returncode == 0:
            mins = "?"
            try:
                with open(LAUNCHD_PLIST, "rb") as fh:
                    mins = plistlib.load(fh).get("StartInterval", 0) // 60
            except (OSError, ValueError):
                pass
            print(f"autosave: on, every {mins} min (launchd agent {LAUNCHD_LABEL})")
        else:
            print("autosave: off  (turn on with `ccsnap auto on`)")
        latest_line()
        return
    if action == "off":
        quiet(["launchctl", "bootout", target])
        try:
            LAUNCHD_PLIST.unlink()
        except OSError:
            pass
        print(f"autosave off (snapshots kept in {SNAP_DIR})")
        return
    # launchd starts jobs with a bare PATH: spell out where tmux and claude live.
    dirs = []
    for d in [os.path.dirname(tmux_bin()), os.path.dirname(shutil.which("claude") or ""),
              "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]:
        if d and d not in dirs:
            dirs.append(d)
    env = {"PATH": ":".join(dirs), "LC_ALL": "en_US.UTF-8"}
    for var in ("CCSNAP_HOME", "CLAUDE_CONFIG_DIR", "TMUX_TMPDIR"):
        if os.environ.get(var):
            env[var] = os.environ[var]
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LAUNCHD_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with open(LAUNCHD_PLIST, "wb") as fh:
        plistlib.dump({
            "Label": LAUNCHD_LABEL,
            "ProgramArguments": [stable_python(), str(Path(__file__).resolve()), "save", "--quiet"],
            "StartInterval": every * 60,
            "RunAtLoad": True,
            "ProcessType": "Background",
            "LowPriorityIO": True,
            "Nice": 10,
            "EnvironmentVariables": env,
            "StandardOutPath": str(AUTO_LOG),
            "StandardErrorPath": str(AUTO_LOG),
        }, fh)
    quiet(["launchctl", "bootout", target])
    r = quiet(["launchctl", "bootstrap", domain, str(LAUNCHD_PLIST)])
    if r.returncode != 0:
        time.sleep(1.0)  # the bootout above can still be settling
        r = quiet(["launchctl", "bootstrap", domain, str(LAUNCHD_PLIST)])
    if r.returncode != 0:
        sys.exit(f"ccsnap: launchctl could not load {LAUNCHD_PLIST}: {r.stderr.strip()}")
    print(f"autosave on: every {every} min, and at login → {SNAP_DIR}")


def cmd_auto(a):
    every = max(1, a.every)
    if MAC:
        launchd_auto(a.action, every)
    elif have_systemd_user():
        systemd_auto(a.action, every)
    else:
        print("autosave needs systemd (Linux) or launchd (macOS), and this system has neither.\n"
              "Add a cron entry instead (crontab -e):\n"
              f"  */{every} * * * * {stable_python()} {Path(__file__).resolve()} save --quiet")
        sys.exit(1)


def main():
    global TMUX_SOCKET
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass
    ap = argparse.ArgumentParser(prog="ccsnap", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-V", "--version", action="version", version=f"ccsnap {__version__}")
    ap.add_argument("-L", dest="socket", metavar="NAME",
                    help="use `tmux -L NAME` instead of the default server (also $CCSNAP_TMUX_SOCKET)")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("save", help="snapshot current tmux + Claude sessions")
    p.add_argument("-q", "--quiet", action="store_true")
    p.add_argument("--auto", action="store_true", help=argparse.SUPPRESS)  # what 0.1's launchd agent passes
    p.add_argument("-f", "--force", action="store_true", help="save even if unchanged")
    p.set_defaults(fn=cmd_save)

    p = sub.add_parser("list", aliases=["ls"], help="list snapshots")
    p.add_argument("-n", type=int, default=20, help="how many to show (default 20)")
    p.set_defaults(fn=cmd_list)

    for name, fn, hlp in (("show", cmd_show, "show what a snapshot contains"),
                          ("restore", cmd_restore, "recreate tmux sessions and resume Claude")):
        p = sub.add_parser(name, help=hlp)
        p.add_argument("snapshot", nargs="?",
                       help="number from `ccsnap list`, a snapshot name or its unique prefix, or a file path")
        p.add_argument("--claude-bin", default="claude", help=argparse.SUPPRESS)
        p.set_defaults(fn=fn)
    p.add_argument("-o", "--only", nargs="+", metavar="SESSION", help="restore just these tmux sessions")
    p.add_argument("-n", "--dry-run", action="store_true", help="print the plan, change nothing")
    p.add_argument("--no-enter", action="store_true", help="type the claude commands but don't run them")
    p.add_argument("-a", "--attach", action="store_true", help="attach to the first restored session")
    p.add_argument("--force", action="store_true", help="start sessions even if they look already running")
    p.add_argument("--replace", action="store_true",
                   help="kill and rebuild tmux sessions that already exist (e.g. after a botched restore)")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask before --replace kills sessions")
    p.add_argument("--wait", type=int, default=300, metavar="SEC",
                   help="how long to wait for missing folders, e.g. a disk still mounting (default 300)")
    p.add_argument("--stagger", type=float, default=0.4, help="seconds between launches (default 0.4)")
    p.add_argument("--settle", type=float, default=1.0, help=argparse.SUPPRESS)

    p = sub.add_parser("auto", help="turn autosave on or off, or show its status")
    p.add_argument("action", nargs="?", choices=["on", "off", "status"], default="status")
    p.add_argument("--every", type=int, default=2, metavar="MIN", help="minutes between snapshots (default 2)")
    p.set_defaults(fn=cmd_auto)
    # The names autosave had before `auto` existed.
    p = sub.add_parser("install", help="same as `auto on`")
    p.add_argument("--every", type=int, default=2, metavar="MIN", help="minutes between snapshots (default 2)")
    p.set_defaults(fn=cmd_auto, action="on")
    p = sub.add_parser("uninstall", help="same as `auto off`")
    p.set_defaults(fn=cmd_auto, action="off", every=2)

    a = ap.parse_args()
    if not a.cmd:  # bare `ccsnap` saves
        a = ap.parse_args(sys.argv[1:] + ["save"])
    if a.socket:
        TMUX_SOCKET = a.socket
    try:
        a.fn(a)
    except RuntimeError as e:
        sys.exit(f"ccsnap: {e}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
